# ==============================================================================
# Database (Neon PostgreSQL: https://neon.tech)
# ==============================================================================
# Di dashboard Neon, klik "Connection Details":
# 1. DATABASE_URL: Pilih "Pooled connection" (ada substring '-pooler')
# 2. DIRECT_URL: Centang/pilih non-pooled (direct connection)
# Jika hanya punya 1 URL dari Neon, isi nilai yang sama ke keduanya.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# Auth.js / NextAuth
# ==============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="komit-local-dev-secret-key-32chars-minimum-abcdef12345"

# ==============================================================================
# GitHub OAuth (User Authentication)
# ==============================================================================
# Buat di https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="replace-with-github-oauth-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-client-secret"

# ==============================================================================
# GitHub App (Repository backfill & webhooks) - Opsional saat awal dev
# ==============================================================================
GITHUB_APP_ID="replace-with-github-app-id"
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="replace-with-github-webhook-secret"

# ==============================================================================
# Resend (Email service) - Opsional saat awal dev (mocked jika kosong)
# ==============================================================================
RESEND_API_KEY=""
EMAIL_FROM="Komit <onboarding@resend.dev>"
